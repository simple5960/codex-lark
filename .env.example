AWS_REGION=us-west-2
AWS_SECRET_ID=simple-codex
# AWS_PROFILE=default
# 国际版 Lark 用 lark，国内飞书用 feishu
LARK_DOMAIN=lark
# 在 Lark 私聊机器人发送 /whoami，填入返回的 ou_ 开头 ID；空值禁止执行任务
ALLOWED_OPEN_IDS=ou_e988b0efe35f221758d3e6565ef5deb8
# 默认为启动目录；建议明确设置为要操作的项目绝对路径
# CODEX_WORKSPACE=/absolute/path/to/project
CODEX_SANDBOX=workspace-write
# 可选，默认使用 Codex 自己的模型设置
# CODEX_MODEL=
TASK_TIMEOUT_MS=1800000
MAX_PARALLEL_TASKS=2
MAX_QUEUED_TASKS=20
# TASK_WORKTREE_ROOT=/absolute/path/to/worktrees
